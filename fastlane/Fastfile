default_platform(:ios)

API_KEY = app_store_connect_api_key(
  key_id:        "G389F99P3B",
  issuer_id:     "69a6de7f-a9c3-47e3-e053-5b8c7c11a4d1",
  key_filepath:  "#{Dir.home}/.appstoreconnect/private_keys/AuthKey_G389F99P3B.p8"
)

SCHEME      = "OpenRHNTracker"
PROJECT     = "OpenRHNTracker.xcodeproj"
BUNDLE_ID   = "info.cafferata.RnhGpxTracker"
SCREENSHOTS = "AppStore/Screenshots"

# AppStore/Screenshots/<locale>/<toestel>/<naam>.png → fastlane/screenshots_flat/<locale>/<toestel>-<naam>.png
# (deliver leest geen toestel-submappen). Alleen de talen van de listing: nl-NL en en-US.
def flat_screenshots
  root = File.expand_path("..", __dir__)
  dst  = File.join(root, "fastlane", "screenshots_flat")
  FileUtils.rm_rf(dst)
  %w[nl-NL en-US].each do |locale|
    Dir.glob(File.join(root, SCREENSHOTS, locale, "*", "*.png")).each do |f|
      device = File.basename(File.dirname(f))
      FileUtils.mkdir_p(File.join(dst, locale))
      FileUtils.cp(f, File.join(dst, locale, "#{device.gsub(/[^A-Za-z0-9.]+/, "_")}-#{File.basename(f)}"))
    end
  end
  dst
end

platform :ios do

  # ─── TestFlight ────────────────────────────────────────────────────────────
  desc "Build en upload naar TestFlight"
  lane :beta do
    # Buildnummer = datum+tijd (yyyymmddHHMM), zoals eerder. Kaal increment_build_number
    # zou de testtargets meetellen. Signing automatisch via Admin-key 5R3497VHF5 (match staat niet op deze Mac).
    increment_build_number(xcodeproj: PROJECT, build_number: Time.now.strftime("%Y%m%d%H%M"))
    build_app(
      project:           PROJECT,
      scheme:            SCHEME,
      configuration:     "Release",
      export_method:     "app-store",
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyPath #{Dir.home}/.appstoreconnect/private_keys/AuthKey_5R3497VHF5.p8 " \
              "-authenticationKeyID 5R3497VHF5 " \
              "-authenticationKeyIssuerID 69a6de7f-a9c3-47e3-e053-5b8c7c11a4d1",
      export_options: { signingStyle: "automatic", teamID: "9J2S23WJH3" }
    )
    upload_to_testflight(
      api_key: API_KEY,
      skip_waiting_for_build_processing: true
    )
  end

  # ─── App Store release ─────────────────────────────────────────────────────
  desc "Build, upload naar App Store en dien in ter beoordeling"
  lane :release do
    increment_build_number(xcodeproj: PROJECT)
    build_app(
      project:           PROJECT,
      scheme:            SCHEME,
      configuration:     "Release",
      export_method:     "app-store",
      export_options: {
        provisioningProfiles: {
          BUNDLE_ID => "match AppStore #{BUNDLE_ID}"
        }
      }
    )
    upload_to_app_store(
      api_key:                      API_KEY,
      submit_for_review:            true,
      automatic_release:            false,
      force:                        true,
      skip_screenshots:             false,
      screenshots_path:             SCREENSHOTS,
      metadata_path:                "fastlane/metadata",
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end

  # ─── Screenshots naar een versie in voorbereiding: fastlane shots version:2.3.0 ─
  lane :shots do |o|
    upload_to_app_store(
      api_key:                              API_KEY,
      app_identifier:                       BUNDLE_ID,
      app_version:                          o[:version],
      skip_binary_upload:                   true,
      skip_metadata:                        true,
      skip_app_version_update:              true,
      overwrite_screenshots:                true,
      force:                                true,
      run_precheck_before_submit:           false,
      screenshots_path:                     flat_screenshots,
      ignore_language_directory_validation: true
    )
  end

  # ─── Alleen screenshots uploaden ───────────────────────────────────────────
  desc "Upload screenshots naar App Store Connect"
  lane :screenshots do
    upload_to_app_store(
      api_key:                              API_KEY,
      app_identifier:                       BUNDLE_ID,
      skip_binary_upload:                   true,
      skip_metadata:                        true,
      force:                                true,
      edit_live:                            true,
      run_precheck_before_submit:           false,
      screenshots_path:                     SCREENSHOTS,
      ignore_language_directory_validation: true
    )
  end

  # ─── Alleen metadata uploaden (voor versie in voorbereiding) ──────────────
  desc "Upload beschrijving en release notes naar App Store Connect"
  lane :metadata do
    upload_to_app_store(
      api_key:                    API_KEY,
      app_identifier:             BUNDLE_ID,
      skip_binary_upload:         true,
      skip_screenshots:           true,
      force:                      true,
      run_precheck_before_submit: false,
      metadata_path:              "fastlane/metadata"
    )
  end

  # ─── Alleen promotional tekst updaten (werkt op live versie) ───────────────
  desc "Update promotional tekst op de live versie"
  lane :promo do
    upload_to_app_store(
      api_key:                    API_KEY,
      app_identifier:             BUNDLE_ID,
      skip_binary_upload:         true,
      skip_screenshots:           true,
      force:                      true,
      edit_live:                  true,
      run_precheck_before_submit: false,
      metadata_path:              "fastlane/metadata_promo"
    )
  end

end
